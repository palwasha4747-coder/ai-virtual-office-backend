#include <iostream>
#include <string>
using namespace std;

// ---------- Lab 2: Remove spaces + comments ----------
string cleanInput(string input) {
    string result = "";
    bool inComment = false;

    for (int i = 0; i < input.length(); i++) {
        if (input[i] == '{') {
            inComment = true;
        }
        else if (input[i] == '}') {
            inComment = false;
        }
        else if (!inComment && input[i] != ' ' && input[i] != '\n' && input[i] != '\t') {
            result += input[i];
        }
    }
    return result;
}

// ---------- Lab 1: DFA using switch ----------
bool DFA_switch(string str) {
    int state = 0;

    for (int i = 0; i < str.length(); i++) {
        char ch = str[i];

        switch (state) {
            case 0:
                if (ch == 'a') state = 1;
                else if (ch == 'b' || ch == 'c') state = 0;
                else return false;
                break;

            case 1: // after 'a', must see 'b'
                if (ch == 'b') state = 0;
                else return false;
                break;
        }
    }

    return (state == 0);
}

// ---------- Lab 1: DFA using goto ----------
bool DFA_goto(string str) {
    int i = 0;
    char ch;

start:
    if (i == str.length()) return true;
    ch = str[i++];

    if (ch == 'a') goto gotA;
    else if (ch == 'b' || ch == 'c') goto start;
    else return false;

gotA:
    if (i == str.length()) return false;
    ch = str[i++];

    if (ch == 'b') goto start;
    else return false;
}

// ---------- Lab 3: Tokenization + Symbol Table ----------
void symbolTable(string str) {
    int countA = 0, countB = 0, countC = 0;

    cout << "Tokens: ";
    for (int i = 0; i < str.length(); i++) {
        cout << str[i];
        if (i != str.length() - 1) cout << ", ";

        if (str[i] == 'a') countA++;
        else if (str[i] == 'b') countB++;
        else if (str[i] == 'c') countC++;
    }

    cout << endl;
    cout << "Symbol table: a:" << countA
         << ", b:" << countB
         << ", c:" << countC << endl;
}

// ---------- Lab 4: Recursive Descent Parser ----------
int indexParser = 0;
string inputStr;

void S() {
    if (indexParser < inputStr.length() &&
        inputStr[indexParser] == 'a' &&
        indexParser + 1 < inputStr.length() &&
        inputStr[indexParser + 1] == 'b') {

        cout << "S -> a b S" << endl;
        indexParser += 2;
        S();
    } else {
        cout << "S -> e" << endl;
    }
}

// ---------- Main ----------
int main() {
    string input;

    cout << "Enter input: ";
    getline(cin, input);

    // Clean input
    string cleaned = cleanInput(input);
    cout << "\nAfter removing whitespace/comments: " << cleaned << endl;

    // DFA check
    if (!DFA_switch(cleaned) || !DFA_goto(cleaned)) {
        cout << "DFA rejected string\n";
        return 0;
    }

    // Tokenization + symbol table
    symbolTable(cleaned);

    // Parsing
    cout << "\nParsing:\n";
    inputStr = cleaned;
    indexParser = 0;

    S();

    if (indexParser == inputStr.length())
        cout << "String accepted.\n";
    else
        cout << "Parse error\n";

    return 0;
}

